---
const {title, desc, slug} = Astro.props
import {fade} from "astro:transitions"
---
<a class="card" href={`/eng/${slug}`}>
  <div class="inner">
    <div>
      <h2 transition:name={`project-title-${slug}`} class="card-title">
          { title }
      </h2>
      <p>
          { desc }
      </p>
    </div>
    <!--<p class="arrow">-->
    <!--  ↗-->
    <!--</p>-->
  </div>
</a>


<style>
  .card {
    display: block;
    color: inherit;
    text-decoration: none;
    margin: 0;
    border-radius: 1rem;
    transition: all .2s ease;
    padding: 1rem;
  }
  .card:hover {
      transform: scale(1.00);
      box-shadow: 0 0 20px rgba(0,0,0,.1);
      background-color: #FFFFFF;
  }
  .card-title{
    margin-block: 1rem 1rem;
  }
  .inner {
      display: flex;
      justify-content: space-between;
  }

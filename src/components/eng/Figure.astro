---
const { path, alt } = Astro.props
import { Image } from 'astro:assets'
---
<figure>
  <Image class="img"
      src={path}
      alt={alt}
  />
</figure>

<style>
  figure {
    flex: 1 1 20ch;
    max-width: 32ch;
    margin: 0;
  }
  .img {
    display: block;
    max-width: 100%;
    height: auto;
  }
</style>
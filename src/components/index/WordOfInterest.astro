---
const { text, href } = Astro.props;
---
<a class="word-of-interest" href = {href}>
    {text}
</a>
<style>
    .word-of-interest {
        display: inline-block;
        transition: 0.2s ease-in-out;
        cursor: pointer;
        color: inherit;
        text-decoration: none;
        background: none;
    }
    .word-of-interest:visited {
        color: inherit;
    }
    .word-of-interest:focus {
        outline: none;
    }
    .word-of-interest:hover {
        text-decoration: underline;
        font-size: 2.05em;
    }

</style>
---
import WordOfInterest from "./WordOfInterest.astro";
const { title } = Astro.props;
---
<div class="card">
    <h1>{title}</h1>
    <p>
        Hey my name is Jack and i love
        <WordOfInterest text="computers, " href="eng"/>
        <WordOfInterest text="roller coasters, "/>
        and
        <WordOfInterest text="lighting design."/>
        I'm currently studying at Boston University for a B.S. in Computer Engineering.
    </p>

    <style>
        .card {
            padding-left: 8px;
            background-color: #222222;
            border: 2px solid #555555;
            border-radius: 8px;
        }
        /*noinspection CssUnresolvedCustomProperty*/
        h1 {
            font-family: var(--work-sans), sans-serif;
            font-weight: bolder;
            margin: 8px;
            color: #DDDDDD;
        }
        p {
            color: #EEEEEE;
            margin-top: 0;
            margin-bottom: 8px;
        }
        /*noinspection CssUnresolvedCustomProperty*/
        body {
            font-family: var(--libre-baskerville), serif;
            cursor: default;
        }
    </style>
</div>

---
import Layout from '../layouts/Layout.astro';
import Greeter from '../components/index/Greeter.astro';
import WordOfInterest from "../components/index/WordOfInterest.astro";
---

<Layout title="jack justus design">
	<div class="header-border block">
		<h1 class="bloom">
			jack justus design
		</h1>
	</div>
	<script is:inline>
		// Weight bloom: the heading stays hidden until Work Sans is ready (or
		// 300ms pass, whichever is first), then fades in thin and grows to bold.
		(() => {
			const h1 = document.querySelector("h1.bloom");
			if (!h1) return;
			const MAX_WAIT_MS = 300;

			// Astro may rename the family, so match on the name rather than an
			// exact string, and skip the generated local "fallback" face.
			const faces = [...document.fonts].filter(
				(f) => f.family.includes("Work Sans") && !f.family.includes("fallback") && f.style === "normal",
			);
			const fontReady = Promise.all(faces.map((f) => f.load())).catch(() => {});
			const timeout = new Promise((r) => setTimeout(r, MAX_WAIT_MS));

			Promise.race([fontReady, timeout]).then(() => {
				// Next frame, so the starting state has painted and the transition runs.
				requestAnimationFrame(() => h1.classList.add("bloomed"));
			});
		})();
	</script>
	<div class="block">
		<p>
			Hey my name is Jack and i love{" "}
			<WordOfInterest text="engineering," href="/eng/"/>{" "}
			roller coasters,
			<!--<WordOfInterest text="roller coasters," href=""/>{" "}-->
			{" "}and{" "}
			<WordOfInterest text="lighting design." href="/lx/"/>{" "}
			I'm currently studying at Boston University for a B.S. in Computer Engineering.
		</p>
	</div>
	<div class="block bottom-block">
		<p class="disclaimer">
			This website is in progress! Feel free to explore, but if you are looking for a
			richer collection of my work,
			please visit <a href="https://jackjustusld.com">jackjustusld.com</a>
		</p>
	</div>

            <!--<Greeter title="jack justus design"></Greeter>-->
	<!--<p>-->
	<!--	This site is currently in progress! -->
	<!--</p>-->
</Layout>

<style>
	body {
		background-color: antiquewhite;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}
	/*noinspection CssUnresolvedCustomProperty*/
	h1 {
		font-family: var(--work-sans), sans-serif;
		font-weight: 700;
		margin: 8px;
		color: bisque;
	}
	/* Starting state: invisible and thin while the font loads. */
	h1.bloom:not(.bloomed) {
		opacity: 0;
		font-weight: 100;
		/* Failsafe: if the script never runs, show the heading anyway. */
		animation: bloom-failsafe 0s 1.5s forwards;
	}
	h1.bloom.bloomed {
		transition:
			opacity 250ms ease-out,
			font-weight 900ms cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	@keyframes bloom-failsafe {
		to {
			opacity: 1;
			font-weight: 700;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		h1.bloom.bloomed {
			transition: none;
		}
	}
	.block {
		background-color: black;
		margin: 1.5rem;
		padding: 1rem;
		border-radius: 1rem;
		box-shadow: 10px 10px orange;
		border: 4px solid antiquewhite;
		transition: ease-in-out 0.4s box-shadow;
	}
	.block:hover {
		box-shadow: 10px 10px coral;
	}
	.bottom-block {
		margin-top: auto;
		margin-bottom: 0;
		border-radius: 1rem 1rem 0 0;
		border: 0 solid antiquewhite;
	}
	a {
		text-decoration: none;
		color: inherit;
	}
	.disclaimer {
		font-size: small;
		font-style: italic;
		text-align: center;
	}
	p {
		font-family: var(--work-sans), sans-serif;
		font-size: large;
		color: antiquewhite;
		margin: 1rem;
	}
</style>
---
import Layout from '../layouts/Layout.astro';
import Greeter from '../components/index/Greeter.astro';
import WordOfInterest from "../components/index/WordOfInterest.astro";
---

<Layout title="jack justus design">
	<div class="header-border block">
		<h1>
			jack justus design
		</h1>
	</div>
	<div class="block">
		<p>
			Hey my name is Jack and i love{" "}
			<WordOfInterest text="engineering," href="eng"/>{" "}
			roller coasters,
			<!--<WordOfInterest text="roller coasters," href=""/>{" "}-->
			{" "}and{" "}
			<WordOfInterest text="lighting design." href="lx"/>{" "}
			I'm currently studying at Boston University for a B.S. in Computer Engineering.
		</p>
	</div>
	<div class="block bottom-block">
		<p class="disclaimer">
			This website is in progress! Feel free to explore, but if you are looking for a
			richer collection of my work,
			please visit <a href="https://jackjustusld.com">jackjustusld.com</a>
		</p>
	</div>

            <!--<Greeter title="jack justus design"></Greeter>-->
	<!--<p>-->
	<!--	This site is currently in progress! -->
	<!--</p>-->
</Layout>

<style>
	body {
		background-color: antiquewhite;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}
	/*noinspection CssUnresolvedCustomProperty*/
	h1 {
		font-family: var(--work-sans), sans-serif;
		font-weight: bolder;
		margin: 8px;
		color: bisque;
	}
	.block {
		background-color: black;
		margin: 1.5rem;
		padding: 1rem;
		border-radius: 1rem;
		box-shadow: 10px 10px orange;
		border: 4px solid antiquewhite;
		transition: ease-in-out 0.4s box-shadow;
	}
	.block:hover {
		box-shadow: 10px 10px coral;
	}
	.bottom-block {
		margin-top: auto;
		margin-bottom: 0;
		border-radius: 1rem 1rem 0 0;
		border: 0 solid antiquewhite;
	}
	a {
		text-decoration: none;
		color: inherit;
	}
	.disclaimer {
		font-size: small;
		font-style: italic;
		text-align: center;
	}
	p {
		font-family: var(--work-sans), sans-serif;
		font-size: large;
		color: antiquewhite;
		margin: 1rem;
	}
</style>
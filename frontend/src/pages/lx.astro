---
import Layout from '../layouts/Layout.astro';
// import Greeter from '../components/index/Greeter.js';
import LxLayout from "../layouts/LxLayout.astro";
import HeroImg from "../components/lx/HeroImg.astro";
import Gallery from "../components/lx/Gallery.astro";
---

<LxLayout title="jack justus design">
	<HeroImg />
	<Gallery />
	<div class="title-track">
		<div class="title-lead"></div>
		<div class="page-title" id="page-title">
			<h2>The Sun</h2>
		</div>
		<div class="title-tail"></div>
	</div>
	<div class="credits" id="credits">
		<div class="credits-card">
			<h3>Credits</h3>
			<p>Lighting Design — Jack Justus</p>
			<p>Connection Pointe Christian Church — Easter 2026</p>
		</div>
	</div>
</LxLayout>

<script>
	const REVEAL_AT = 0.5;
	const WIPE_AT = 2;
	const CREDITS_AT = 2.5;

	let onScroll: (() => void) | null = null;

	function initTitle() {
		if (CSS.supports('animation-timeline', 'scroll()')) return;

		if (onScroll) window.removeEventListener('scroll', onScroll);

		const title = document.getElementById('page-title');
		const credits = document.getElementById('credits');
		if (!title || !credits) return;

		onScroll = () => {
			const vh = window.innerHeight;
			title.classList.toggle('shown', window.scrollY > vh * REVEAL_AT);
			title.classList.toggle('wiped', window.scrollY > vh * WIPE_AT);
			credits.classList.toggle('shown', window.scrollY > vh * CREDITS_AT);
		};

		window.addEventListener('scroll', onScroll, { passive: true });
		onScroll();
	}

	initTitle();
	document.addEventListener('astro:page-load', initTitle);
</script>

<style>
	.title-track {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: calc(var(--hero-track) + var(--stage-track));
		display: flex;
		flex-direction: column;
		z-index: 2;
		pointer-events: none;
	}

	.title-lead {
		flex: 1;
	}

	.title-tail {
		flex: 0 0 var(--stage-track);
	}

	.page-title {
		position: sticky;
		top: 0;
		bottom: 0;
		margin: 2rem;
		display: flex;
		justify-content: center;
	}

	.credits {
		position: fixed;
		inset: 0;
		display: grid;
		place-items: center;
		z-index: 3;
		pointer-events: none;
		opacity: 0;
	}

	.credits-card {
		text-align: center;
		color: #f3ede5;
		padding: 2rem;
	}

	@keyframes title-in {
		from {
			opacity: 0;
			transform: translateY(2rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes title-wipe {
		from {
			clip-path: inset(0 0 0 0);
		}
		to {
			clip-path: inset(100% 0 0 0);
		}
	}

	@keyframes credits-in {
		from {
			opacity: 0;
			transform: translateY(1.5rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@supports (animation-timeline: scroll()) {
		.page-title {
			animation: title-in ease-out both, title-wipe linear both;
			animation-timeline: scroll(root block), scroll(root block);
			animation-range: 0 100vh, 200vh 250vh;
		}

		.credits {
			animation: credits-in ease-out both;
			animation-timeline: scroll(root block);
			animation-range: 250vh 330vh;
		}
	}

	@supports not (animation-timeline: scroll()) {
		.page-title {
			opacity: 0;
			transform: translateY(2rem);
			transition: opacity 0.6s ease-out, transform 0.6s ease-out, clip-path 0.4s ease-out;
		}
		.page-title.shown {
			opacity: 1;
			transform: translateY(0);
		}
		.page-title.wiped {
			clip-path: inset(100% 0 0 0);
		}
		.credits {
			transition: opacity 0.6s ease-out, transform 0.6s ease-out;
			transform: translateY(1.5rem);
		}
		.credits.shown {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.lx :global(p) {
		color: #714b4b;
	}
	/*noinspection CssUnresolvedCustomProperty*/
	.lx :global(h1)  {
		font-family: var(--work-sans), sans-serif;
		font-weight: bolder;
		margin: 8px;

	}
	h2 {
		color: #d5d5d5;
		font-size: xxx-large;
		text-shadow: 0 0 0.5rem antiquewhite;
		margin: 1rem;
	}
	.lx :global(p)  {
		margin-top: 0;
		margin-bottom: 8px;
	}
	/*noinspection CssUnresolvedCustomProperty*/
	.lx :global(body),
	.lx {
		font-family: var(--libre-baskerville), serif;
		cursor: default;
	}
</style>
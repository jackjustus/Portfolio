---
import Layout from '../layouts/Layout.astro';
import Greeter from '../components/index/Greeter.js';
import LxLayout from "../layouts/LxLayout.astro";
import HeroImg from "../components/lx/HeroImg.astro";
---

<LxLayout title="Jack's Blog">
	<HeroImg />
</LxLayout>

<style>
	.lx :global(p) {
		color: #714b4b;
	}
	/*noinspection CssUnresolvedCustomProperty*/
	.lx :global(h1)  {
		font-family: var(--work-sans), sans-serif;
		font-weight: bolder;
		margin: 8px;

	}
	.lx :global(p)  {
		margin-top: 0;
		margin-bottom: 8px;
	}
	/*noinspection CssUnresolvedCustomProperty*/
	.lx :global(body),
	.lx {
		font-family: var(--libre-baskerville), serif;
		cursor: default;
	}
</style>
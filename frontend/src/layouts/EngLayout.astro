---
import Layout from './Layout.astro';
const { title } = Astro.props;
---
<Layout title={title}>
    <div><slot /></div>
</Layout>

<style is:global>
  p {
      color: #a89984;
      margin-block: 0.4rem 1rem;
      margin-inline: 0.5rem;
  }
  /*noinspection CssUnresolvedCustomProperty*/
  h1  {
      font-family: var(--font-vga), monospace;
      font-weight: normal;
      -webkit-font-smoothing: none;
      color: #ebdbb2;
      padding: 0;
      font-size: 48px;
      margin: 8px 8px 8px 8px;
  }
  /*noinspection CssUnresolvedCustomProperty*/
  h2  {
      font-family: var(--font-vga), monospace;
      font-weight: normal;
      color: #ebdbb2;
      margin-block: 2rem 1rem;
      margin-inline: 0.5rem;
      font-size: xx-large;
  }
  /*noinspection CssUnresolvedCustomProperty*/
  h3 {
      font-family: var(--font-vga), monospace;
      font-weight: normal;
      color: #ebdbb2;
      font-size: 16px;
      margin-block: 0 0;
      margin-inline: 0.5rem;
  }
  hr {
      border: 0;
      border-top: 4px solid #458588;
  }
  /*noinspection CssUnresolvedCustomProperty*/
  body {
      min-height: 100vh;
      font-family: var(--font-vga), monospace;
      font-size: 16px;
      font-weight: normal;
      cursor: default;
  }
  html {
      background-color: #282828;
  }
</style>
---
import Layout from './Layout.astro';
const { title } = Astro.props;
---
<Layout title={title}>
    <div><slot /></div>
</Layout>

<style is:global>
  .lx p {
      color: #ebdbb2;
      margin-block: 0.4rem 1rem;
      margin-inline: 0.5rem;
  }
  /*noinspection CssUnresolvedCustomProperty*/
  .lx h1  {
      font-family: var(--font-vga), monospace;
      -webkit-font-smoothing: none;
      font-weight: bolder;
      color: #ebdbb2;
      padding: 0;
      font-size: 48px;
      margin: 8px 8px 8px 8px;
  }
  /*noinspection CssUnresolvedCustomProperty*/
  .lx h2  {
      font-family: var(--font-vga), serif;
      color: #ebdbb2;
      font-weight: bolder;
      margin-block: 2rem 1rem;
      margin-inline: 0.5rem;
      font-size: xx-large;
  }
  /*noinspection CssUnresolvedCustomProperty*/
  .lx h3 {
      font-family: var(--work-sans), sans-serif;
      font-weight: bolder;
      margin: 0;
      font-size: large;
      margin-block: 0 0;
      margin-inline: 0.5rem;
  }
  /*noinspection CssUnresolvedCustomProperty*/
  .lx {
      min-height: 100vh;
      font-family: var(--libre-baskerville), serif;
      cursor: default;
  }
  html {
      background-color: #282828;
  }
</style>
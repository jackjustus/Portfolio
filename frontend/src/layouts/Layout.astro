---
import '../styles/jack.css'
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
const { title } = Astro.props;
---
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-4F42X95MK1"></script>
        <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', 'G-4F42X95MK1');
        </script>
        <link rel="icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
        <link rel="preconnect" href="https://static.jackjust.com"/>
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <Font cssVariable="--work-sans" />
        <Font cssVariable="--libre-baskerville" />
        <Font cssVariable="--font-vga" preload={true}/>
        <title>{title}</title>
        <ClientRouter />
    </head>
<body transition:animate="slide">
    <slot />
</body>
</html>
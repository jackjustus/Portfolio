---
import '../styles/jack.css'
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
// Fonts to preload, by cssVariable. Preloading lets the browser fetch the font
// alongside the HTML instead of discovering it after CSS parses, which is what
// causes the fallback-then-swap flash. Only preload what the page shows above
// the fold: every preload competes for bandwidth with the ones that matter.
const { title, preloadFonts = ["--work-sans"] } = Astro.props;
---
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-4F42X95MK1"></script>
        <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', 'G-4F42X95MK1');
        </script>
        <link rel="icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
        <link rel="preconnect" href="https://static.jackjust.com"/>
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <Font
            cssVariable="--work-sans"
            preload={preloadFonts.includes("--work-sans") && [
                { weight: "400" },                    // body, incl. the italic disclaimer
                { weight: "700", style: "normal" },   // headings (no bold italic on the page)
            ]}
        />
        <Font cssVariable="--libre-baskerville" preload={preloadFonts.includes("--libre-baskerville")} />
        <Font cssVariable="--font-vga" preload={preloadFonts.includes("--font-vga")} />
        <title>{title}</title>
        <ClientRouter />
    </head>
<body transition:animate="slide">
    <slot />
</body>
</html>
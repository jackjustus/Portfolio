---
const {title, desc, slug, href} = Astro.props
interface Props {
  title: string;
  desc: string;
  slug?: string;
  href?: string;
}
const comingSoon = !slug && !href
const Tag = comingSoon ? 'div' : 'a'
const linkProps = slug
  ? {href: `/eng/${slug}`}
  : href
    ? {href, target: '_blank', rel: 'noopener noreferrer'}
    : {}
import {fade} from "astro:transitions"
---
<Tag class="card" {...linkProps}>
  <div class="inner">
    <div>
      <h2 transition:name={`project-title-${slug}`} class="card-title">
          { title }
      </h2>
      <p>
          { desc }
      </p>
    </div>
    <!--<p class="arrow">-->
    <!--  ↗-->
    <!--</p>-->
  </div>
  {comingSoon &&
      <div class="overlay">
        <h1 class="overlay-text">
          COMING SOON
        </h1>
      </div>
  }

</Tag>


<style>
  .card {
    display: block;
    position: relative;
    color: inherit;
    text-decoration: none;
    margin: 2rem 0;
    border-radius: 0;
    transition: all .2s ease;
    padding: 1rem;
    outline: 2px solid #665c54;
    box-shadow: 10px 10px 10px rgba(0,0,0,1);
  }
  .card:hover {
      //background-color: #FFFFFF;
    outline: 2px solid #fabd2f;
  }
  .card-title{
    margin-block: 1rem 1rem;
  }
  .inner {
      display: flex;
      justify-content: space-between;
  }
  .overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    background: rgba(255,255,255,0);
    border-radius: inherit;
    transition: all .4s ease;

  }
  .overlay:hover {
    opacity: 100;
    backdrop-filter: blur(16px);
    background: rgba(255,255,255,.5);
  }
  .overlay-text {
    padding: 0;
    margin: 0;
  }
  //.arrow {
  //    font-size: x-large;
  //    opacity: 0;
  //}
  //.arrow:hover {
  //    opacity: 1;
  //}
  //h2 {
  //  font-family: var(--libre-baskerville), serif;
  //}
</style>
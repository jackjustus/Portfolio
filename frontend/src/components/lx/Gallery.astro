---
import {cdn, srcset} from "../../scripts/cdn.ts";

const DIR = 'lx/2026_connection_pointe_easter';

/* Sources are 2:3 (Vert*) and 3:2 (Horz*). A 3:2 landscape in a square cell
   is cropped to a third of its width, so horizontals span 2 columns: a 2:1
   box holds them at ~25% crop and reads as a wide shot rather than a
   mangled one.

   Order below is pure curation — `pack` works out the columns. Tiles past the
   grid's capacity are never rendered, so the tail of the list acts as spares. */
const tiles = [
    // { file: 'CPEasterHorzWht1.jpg',     alt: 'Wide stage in a white wash' },
    // { file: 'CPEasterVertWarm3.jpg',    alt: 'Warm wash, third look' }, // REPLACE
    // { file: 'CPEasterHorzWht2.jpg',     alt: 'Wide white-lit stage, second look' },
    { file: 'CPEasterVertRed1.jpg',     alt: 'Red uplight on the set' },
    // { file: 'CPEasterVertWarm1.jpg',    alt: 'Warm amber front light' },
    { file: 'CPEasterHorzCold1.jpg',    alt: 'Wide stage in a cold wash' },

    { file: 'CPEasterVertBlue1.jpg',    alt: 'Saturated blue vertical beams' },
    { file: 'CPEasterVertWht1.png',     alt: 'White key light on the stage' },
    //
    { file: 'CPEasterVertCold2.jpg',    alt: 'Cold wash, second look' },
    // { file: 'CPEasterVertPurple1.jpg',  alt: 'Purple wash with haze' },
    { file: 'CPEasterHorzRed1.jpg',     alt: 'Wide stage in deep red' },
    { file: 'CPEasterVertWht2.jpg',     alt: 'White wash, second look' },
    // { file: 'CPEasterVertWarm2.jpg',    alt: 'Warm wash, second look' },
    { file: 'CPEasterVertOrang1.png',   alt: 'Orange wash across the rig' },
    //
    // { file: 'CPEasterVertRed2.jpg',     alt: 'Red beams, second look' },
    { file: 'CPEasterVertWht5.png',     alt: 'White wash, third look' },
    // { file: 'CPEasterVertCold3.jpg',    alt: 'Cold wash, third look' },
    { file: 'CPEasterVertCold1.jpg',    alt: 'Cold blue wash across the upstage rig' },
    { file: 'CPEasterVertRed3.jpg',     alt: 'Red beams, third look' },
    //
    // { file: 'CPEasterVertCold4.jpg',    alt: 'Cold wash, fourth look' },
    // { file: 'CPEasterHorzMessage1.jpg', alt: 'Wide stage during the message' },
    { file: 'CPEasterVertWht6.jpg',     alt: 'White wash, fourth look' },
    { file: 'CPEasterVertCold5.jpg',    alt: 'Cold wash, fifth look' },
    //MAYBE { file: 'CPEasterVertWht7.jpg',     alt: 'White wash, fifth look' },
    { file: 'CPEasterVertCold6.jpg',    alt: 'Cold wash, sixth look' },
    //
    { file: 'CPEasterHorzWarm1.jpg',    alt: 'Wide stage in warm amber' },
    { file: 'CPEasterHorzRed2.jpg',     alt: 'Wide red stage, second look' },
    { file: 'CPEasterHorzWht3.jpg',     alt: 'Wide white-lit stage, third look' },
    { file: 'CPEasterHorzWht4.jpg',     alt: 'Wide white-lit stage, fourth look' },
    { file: 'CPEasterHorzWht5.jpg',     alt: 'Wide white-lit stage, fifth look' },
    // { file: 'CPEasterHorzWht6.jpg',     alt: 'Wide white-lit stage, sixth look' },
    // { file: 'CPEasterVertWht8.jpg',     alt: 'White wash, sixth look' },
    { file: 'CPEasterVertWht9.jpg',     alt: 'White wash, seventh look' },
];

/* Greedy row packer. Walks the curated order and drops each tile into the next
   free cell; a wide tile needs two free columns, so when only the last column of
   a row is open it is held back and the next narrow tile takes that cell — the
   wide then lands at the head of the following row. The grid stays hole-free
   whatever order the tiles are in, and no horizontal is pinned to a column. */
function pack<T extends { wide: boolean }>(list: T[], cols: number, rows: number): T[] {
    const capacity = cols * rows;
    const out: T[] = [];
    const held: T[] = [];
    let used = 0;

    const place = (t: T) => {
        const span = t.wide ? 2 : 1;
        if (used + span > capacity) return false;
        if (span === 2 && used % cols === cols - 1) return false;   // would straddle a row edge
        out.push(t);
        used += span;
        return true;
    };

    for (const t of list) {
        if (used === capacity) break;
        while (held.length && place(held[0])) held.shift();
        if (!place(t) && t.wide) held.push(t);
    }
    return out;
}

const all = tiles.map((t) => ({
    ...t,
    wide: t.file.includes('Horz'),
    path: `${DIR}/${t.file}`,
}));

/* Each breakpoint packs the one above it, so mobile ⊆ tablet ⊆ desktop — the
   media queries stack, and a tile hidden at 1100px must stay hidden at 700px. */
const rendered = pack(all, 7, 4);
const tablet = new Set(pack(rendered, 4, 5));
const mobile = new Set(pack([...tablet], 2, 4));

const classes = (t: typeof rendered[number]) => [
    'tile',
    t.wide ? 'wide' : '',
    mobile.has(t) ? '' : 'hide-mobile',
    tablet.has(t) ? '' : 'hide-tablet',
].filter(Boolean).join(' ');
---

<section class="stage">
    <div class="gallery">
        {rendered.map((t) => (
            <img
                src={cdn(t.path, t.wide ? 600 : 400)}
                srcset={srcset(t.path, t.wide ? [600, 1200] : [400, 800])}
                sizes={t.wide
                    ? '(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 28vw'
                    : '(max-width: 700px) 50vw, (max-width: 1100px) 25vw, 14vw'}
                alt={t.alt}
                loading={mobile.has(t) ? 'eager' : 'lazy'}
                fetchpriority="low"
                decoding="async"
                class={classes(t)}
            />
        ))}
    </div>
    <!--<div class="title-card"><slot /></div>-->
</section>

<style>
    /* One viewport tall, grid centred and clipped. Square cells, so the
       7x4 grid covers the viewport exactly at any aspect ratio. */
    .stage {
        height: 100vh;
        overflow: hidden;
        display: grid;
        grid-template-areas: "stack";
        place-content: center;
        background-color: #0F0F0F;
    }

    .gallery,
    .title-card {
        grid-area: stack;
    }

    /* Width covers the viewport in both axes: at square the grid is cols/rows
       wide per unit tall, so 7/4 -> 175vh. --cell is that width divided by the
       column count (minus gaps), i.e. the height a square tile needs. */
    .gallery {
        --cell: calc((max(100vw, 175vh) - 12px) / 7);
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        grid-auto-flow: row;   /* `pack` guarantees alignment, so a gap here is a bug, not something to backfill */
        width: max(100vw, 175vh);
        gap: 2px;
        filter: brightness(0.75);
    }

    .tile {
        display: block;
        width: 100%;
        height: var(--cell);
        object-fit: cover;
        background-color: #1a1a1a;
    }

    .wide {
        grid-column: span 2;
    }

    /* radial scrim keeps the text legible over the lit photographs */
    .title-card {
        place-self: center;
        z-index: 1;
        text-align: center;
        padding: 4rem 2rem;
        color: #f3ede5;
        background: radial-gradient(ellipse at center, rgb(15 15 15 / 0.85) 0%, rgb(15 15 15 / 0) 70%);
    }

    /* slotted content carries the parent page's scope, so reach it globally
       and outrank the .lx p / .lx h2 rules from LxLayout */
    .title-card :global(h2),
    .title-card :global(p) {
        color: #f3ede5;
        margin-inline: 0;
    }

    /* 4 cols x 5 rows -> 4/5 -> 80vh */
    @media (max-width: 1100px) {
        .gallery {
            --cell: calc((max(100vw, 80vh) - 6px) / 4);
            grid-template-columns: repeat(4, 1fr);
            width: max(100vw, 80vh);
        }
        .hide-tablet { display: none; }
    }

    /* 2 cols x 4 rows -> 2/4 -> 50vh */
    @media (max-width: 700px) {
        .gallery {
            --cell: calc((max(100vw, 50vh) - 2px) / 2);
            grid-template-columns: repeat(2, 1fr);
            width: max(100vw, 50vh);
        }
        .hide-mobile { display: none; }
    }
</style>

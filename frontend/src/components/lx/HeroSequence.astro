---
import HeroImg from "./HeroImg.astro";
import Gallery from "./Gallery.astro";

const title = "The Sun";
---

<div class="hero-sequence">
	<HeroImg />
	<Gallery>
		<div class="credits" id="credits">
			<p class="role">set & lx</p>
			<p>jake collins & jack justus</p>
			<p class="role">venue</p>
			<p>connection pointe</p>
			<p class="role">photos</p>
			<p>aaron williams & connection pointe</p>
			<h2 class="title-ghost" aria-hidden="true">{title}</h2>
		</div>
	</Gallery>
	<div class="page-title" id="page-title">
		<h2>{title}</h2>
	</div>
</div>

<script>
	const REVEAL_AT = 0.5;
	const DRIFT_AT = 1;
	const CREDITS_AT = 1.6;
	const EXIT_AT = 2.5;

	let onScroll: (() => void) | null = null;

	function initTitle() {
		if (CSS.supports('animation-timeline', 'scroll()')) return;

		if (onScroll) window.removeEventListener('scroll', onScroll);

		const title = document.getElementById('page-title');
		const credits = document.getElementById('credits');
		if (!title || !credits) return;

		onScroll = () => {
			const vh = window.innerHeight;
			title.classList.toggle('shown', window.scrollY > vh * REVEAL_AT);
			title.classList.toggle('drifted', window.scrollY > vh * DRIFT_AT);
			title.classList.toggle('exited', window.scrollY > vh * EXIT_AT);
			credits.classList.toggle('shown', window.scrollY > vh * CREDITS_AT);
		};

		window.addEventListener('scroll', onScroll, { passive: true });
		onScroll();
	}

	initTitle();
	document.addEventListener('astro:page-load', initTitle);
</script>

<style>
	@property --glow {
		syntax: '<number>';
		inherits: true;
		initial-value: 1;
	}

	.hero-sequence {
		--hero-track: 200vh;
		--stage-track: 150vh;
		--outro-track: 100vh;
		--stage-unpin: calc(var(--hero-track) + var(--stage-track) - 100vh);
		--credits-in: 160vh;
		--credits-len: 40vh;
		--title-end: 35vh;
		--title-room: 5.6rem;
		--credits-lip: 1.5rem;
	}

	.page-title {
		--title-start: 78vh;
		--title-fade-ease: ease-out;
		--title-drift-ease: cubic-bezier(0.5, 1, 0.89, 1);
		--title-travel: calc(var(--title-end) - var(--title-start));
		--title-exit: calc(-1 * var(--outro-track));

		position: fixed;
		top: var(--title-start);
		left: 0;
		right: 0;
		display: flex;
		justify-content: center;
		z-index: 2;
		pointer-events: none;
	}

	.outro {
		height: var(--outro-track);
	}

	.credits {
		--credits-pad: 3rem;

		position: absolute;
		top: calc(var(--title-end) - var(--credits-lip));
		left: 0;
		right: 0;
		width: min(40rem, 80vw);
		margin-inline: auto;
		padding: calc(var(--credits-lip) + var(--title-room)) 2rem var(--credits-pad);
		text-align: center;
		opacity: 0;
		pointer-events: none;
		display: grid;
		grid-template-columns: minmax(max-content, 1fr) max-content minmax(0, 1fr);
		align-items: baseline;
		background-color: rgb(0 0 0 / 0.5);
		border: antiquewhite solid 4px;
		border-radius: 2rem;
		box-shadow: 0 0rem 2rem rgb(250 235 215 / 0.4);
	}

	.credits .role {
		grid-column: 1;
		text-align: right;
	}

	.credits p:not(.role) {
		grid-column: 2 / -1;
		padding-left: 2.5rem;
	}

	.title-ghost {
		grid-column: 2;
		height: 0;
		margin: 0;
		overflow: hidden;
		visibility: hidden;
	}

	.credits p {
		text-align: left;
		color: #f3ede5;
		margin-inline: 0;
	}

	h2 {
		color: #d5d5d5;
		font-size: 3rem;
		line-height: 1.2;
		--h2-glow: 0 0 12px rgb(250 235 215 / var(--glow));
		text-shadow: var(--h2-glow);
		/*text-shadow: 0 0 0.3rem #FAEBD750;*/
		margin: 1rem;
	}

	/*safari special text shadow*/
	@supports (background: -webkit-named-image(i)) {
		h2 {
			--h2-glow: 0 0 8px rgb(250 235 215 / calc(0.31 * var(--glow)));
		}
	}

	@keyframes title-arc {
		0% {
			opacity: 0;
			translate: 0 0;
			--glow: 1;
		}
		50% {
			opacity: 1;
			translate: 0 0;
			animation-timing-function: var(--title-drift-ease);
		}
		85% {
			--glow: 1;
		}
		100% {
			opacity: 1;
			translate: 0 var(--title-travel);
			--glow: 0;
		}
	}

	@keyframes title-leave {
		from {
			transform: translateY(0);
		}
		to {
			transform: translateY(var(--title-exit));
		}
	}

	@keyframes credits-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@supports (animation-timeline: scroll()) {
		.page-title {
			animation: title-arc var(--title-fade-ease) both, title-leave linear both;
			animation-timeline: scroll(root block), scroll(root block);
			animation-range: 0 var(--hero-track), var(--stage-unpin) calc(var(--stage-unpin) + var(--outro-track));
		}

		.credits {
			animation: credits-in ease-out both;
			animation-timeline: scroll(root block);
			animation-range: var(--credits-in) calc(var(--credits-in) + var(--credits-len));
		}
	}

	@supports not (animation-timeline: scroll()) {
		.page-title {
			opacity: 0;
			transition: opacity 0.6s var(--title-fade-ease), translate 0.8s var(--title-drift-ease), --glow 0.3s ease-out 0.5s, transform 0.6s linear;
		}
		.page-title.shown {
			opacity: 1;
		}
		.page-title.drifted {
			translate: 0 var(--title-travel);
			--glow: 0;
		}
		.page-title.exited {
			transform: translateY(var(--title-exit));
		}
		.credits {
			transition: opacity 0.6s ease-out;
		}
		.credits.shown {
			opacity: 1;
		}
	}
</style>

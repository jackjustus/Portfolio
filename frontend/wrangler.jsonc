{
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-07-13",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/eng/resume.pdf"]
  },
  "env": {
    "preview": {
      "name": "portfolio-staging",
      "analytics_engine_datasets": [
        { "binding": "ANALYTICS_ENGINE", "dataset": "analytics_staging" }
      ]
    }
  },
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS_ENGINE", "dataset": "analytics" }
  ]
}
